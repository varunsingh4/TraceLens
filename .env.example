# Postgres is mapped to 5433 so it is less likely to clash with a local Postgres.
DATABASE_URL=postgresql+psycopg2://tracelens:tracelens@localhost:5433/tracelens
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tracelens_chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=80
